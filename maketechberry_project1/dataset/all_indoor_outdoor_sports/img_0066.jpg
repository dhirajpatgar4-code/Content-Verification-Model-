        <script nonce="">
            if (window.theme === 'gill') {
                document.querySelector('body').classList.add('gill-theme');
                document.querySelector('body').classList.remove('porter-theme');
            } else if (theme === 'porter') {
                document.querySelector('body').classList.add('porter-theme');
                document.querySelector('body').classList.remove('gill-theme');
            }
        </script>
