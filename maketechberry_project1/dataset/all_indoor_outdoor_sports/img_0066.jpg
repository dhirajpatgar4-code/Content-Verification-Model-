        <script nonce="">
            function changeFavicon(src) {
                let favicon = document.querySelector("link[rel*='icon']");

                if (favicon !== null) {
                    favicon.href = src;
                    favicon.type = 'image/svg+xml';
                } else {
                    favicon = document.createElement('link');
                    favicon.rel = 'icon';
                    favicon.type = 'image/svg+xml';
                    favicon.href = src;
                    document.head.appendChild(favicon);
                }
            }

            window.theme = sessionStorage.getItem('theme');

            if(!theme) {
                window.theme = 'gill';
            }

            if (window.location.pathname.includes('/porter')) {
                window.theme = 'porter';
            }






            sessionStorage.setItem('theme', window.theme);

            if (window.theme === 'gill') {
                changeFavicon('/content/favicon/FaviconGill.svg');
            } else if (theme === 'porter') {
                changeFavicon('/content/favicon/FaviconPorter.svg');
            }


            if (theme === 'porter' && document.title.includes("Gill Athletics")) {
                document.title = document.title.replace("Gill Athletics", "Porter Athletic");
            }
        </script>
    </head>
